# Sanity Configuration
# Copy this file to .env.local and fill in your actual values

# Your Sanity project ID (found in your Sanity project dashboard)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Your Sanity dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Your Sanity API token with Editor permissions
# Create this in your Sanity project dashboard under API > Tokens
SANITY_API_TOKEN=your-api-token-here

# Optional: Set to false in development, true in production
NEXT_PUBLIC_SANITY_USE_CDN=true
