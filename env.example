# Sanity Configuration
# Copy this file to .env.local and fill in your actual values

# Your Sanity project ID (found in your Sanity project dashboard)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Your Sanity dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Your Sanity API token with Editor permissions
# Create this in your Sanity project dashboard under API > Tokens
SANITY_API_TOKEN=your-api-token-here

# Optional: Set to false in development, true in production
NEXT_PUBLIC_SANITY_USE_CDN=true

# =============================================================================
# BREVO (SENDINBLUE) EMAIL MARKETING CONFIGURATION
# =============================================================================

# Your Brevo API key (found in your Brevo dashboard under SMTP & API)
BREVO_API_KEY=your-brevo-api-key-here

# Newsletter list ID (found in your Brevo dashboard under Contacts > Lists)
BREVO_NEWSLETTER_LIST_ID=1

# Waitlist list ID (found in your Brevo dashboard under Contacts > Lists)
BREVO_WAITLIST_LIST_ID=2

# Investor-specific list ID (optional)
BREVO_INVESTORS_LIST_ID=3

# Developer-specific list ID (optional)
BREVO_DEVELOPERS_LIST_ID=4

# Ecosystem-specific list ID (optional)
BREVO_ECOSYSTEM_LIST_ID=5

# Email template IDs (found in your Brevo dashboard under Templates)
BREVO_WELCOME_TEMPLATE_ID=1
BREVO_NEWSLETTER_CONFIRMATION_TEMPLATE_ID=2
