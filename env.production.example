# Production Environment Configuration for LandLedger
# Copy this file to .env.production and fill in your actual production values

# =============================================================================
# SANITY CONFIGURATION
# =============================================================================

# Your Sanity project ID (found in your Sanity project dashboard)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-production-project-id

# Your Sanity dataset name (use "production" for production)
NEXT_PUBLIC_SANITY_DATASET=production

# Production Sanity API token with Editor permissions
# Create this in your Sanity project dashboard under API > Tokens
# Use a token with minimal required permissions for security
SANITY_PRODUCTION_TOKEN=your-production-api-token-here

# Enable CDN for production (better performance)
NEXT_PUBLIC_SANITY_USE_CDN=true

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Your production domain (used for CORS and preview mode)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Environment indicator
NODE_ENV=production

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment notification webhook (optional)
# Set this to receive notifications about deployment status
NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Backup retention period (in days)
BACKUP_RETENTION_DAYS=30

# Auto-rollback on failure (true/false)
AUTO_ROLLBACK_ON_FAILURE=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Image optimization settings
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=85

# Query optimization
QUERY_MAX_DEPTH=5
QUERY_MAX_RESULTS=100
QUERY_TIMEOUT_MS=30000

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Error tracking service (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics tracking ID (optional)
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# =============================================================================
# CONTENT VALIDATION
# =============================================================================

# Content validation strictness
CONTENT_VALIDATION_STRICT=true
CONTENT_ALLOW_UNKNOWN_FIELDS=false
CONTENT_REQUIRE_ALL_FIELDS=true

# Field validation limits
CONTENT_MAX_TITLE_LENGTH=100
CONTENT_MAX_EXCERPT_LENGTH=200
CONTENT_MAX_SEO_DESCRIPTION_LENGTH=160

# Image requirements
CONTENT_MIN_IMAGE_WIDTH=800
CONTENT_MIN_IMAGE_HEIGHT=600
CONTENT_MAX_IMAGE_FILE_SIZE=5MB

# =============================================================================
# WORKFLOW CONFIGURATION
# =============================================================================

# Content approval workflow
CONTENT_REQUIRES_APPROVAL=true
CONTENT_APPROVAL_NOTIFICATIONS=true

# Deployment schedule (UTC timezone)
DEPLOYMENT_START_TIME=22:00
DEPLOYMENT_END_TIME=06:00

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_AUTO_CLEANUP=true
BACKUP_MAX_VERSIONS=5

# Recovery configuration
RECOVERY_AUTO_ROLLBACK=false
RECOVERY_NOTIFICATION_ON_FAILURE=true

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Email notifications (optional)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#deployments

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Override any development settings here
# These should typically be false or disabled in production
DEBUG_MODE=false
DEVELOPMENT_FEATURES_ENABLED=false
TEST_DATA_ENABLED=false

