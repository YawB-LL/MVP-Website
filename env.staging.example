# Staging Environment Configuration for LandLedger
# Copy this file to .env.staging and fill in your actual staging values

# =============================================================================
# SANITY CONFIGURATION
# =============================================================================

# Your Sanity project ID (found in your Sanity project dashboard)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-staging-project-id

# Your Sanity dataset name (use "staging" for staging environment)
NEXT_PUBLIC_SANITY_DATASET=staging

# Staging Sanity API token with Editor permissions
# Create this in your Sanity project dashboard under API > Tokens
SANITY_STAGING_TOKEN=your-staging-api-token-here

# Disable CDN for staging (better for testing)
NEXT_PUBLIC_SANITY_USE_CDN=false

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Your staging domain (used for CORS and preview mode)
NEXT_PUBLIC_SITE_URL=https://staging.yourdomain.com

# Environment indicator
NODE_ENV=staging

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment notification webhook (optional)
# Set this to receive notifications about deployment status
NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Backup retention period (in days)
BACKUP_RETENTION_DAYS=7

# Auto-rollback on failure (true/false)
AUTO_ROLLBACK_ON_FAILURE=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:3000

# Rate limiting configuration (more lenient for staging)
RATE_LIMIT_MAX_REQUESTS=2000
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Image optimization settings
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=80

# Query optimization
QUERY_MAX_DEPTH=5
QUERY_MAX_RESULTS=100
QUERY_TIMEOUT_MS=30000

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Error tracking service (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics tracking ID (staging environment)
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# =============================================================================
# CONTENT VALIDATION
# =============================================================================

# Content validation strictness (less strict for staging)
CONTENT_VALIDATION_STRICT=false
CONTENT_ALLOW_UNKNOWN_FIELDS=true
CONTENT_REQUIRE_ALL_FIELDS=false

# Field validation limits
CONTENT_MAX_TITLE_LENGTH=100
CONTENT_MAX_EXCERPT_LENGTH=200
CONTENT_MAX_SEO_DESCRIPTION_LENGTH=160

# Image requirements
CONTENT_MIN_IMAGE_WIDTH=800
CONTENT_MIN_IMAGE_HEIGHT=600
CONTENT_MAX_IMAGE_FILE_SIZE=5MB

# =============================================================================
# WORKFLOW CONFIGURATION
# =============================================================================

# Content approval workflow (less strict for staging)
CONTENT_REQUIRES_APPROVAL=false
CONTENT_APPROVAL_NOTIFICATIONS=false

# Deployment schedule (UTC timezone) - more flexible for staging
DEPLOYMENT_START_TIME=00:00
DEPLOYMENT_END_TIME=23:59

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_AUTO_CLEANUP=true
BACKUP_MAX_VERSIONS=3

# Recovery configuration
RECOVERY_AUTO_ROLLBACK=true
RECOVERY_NOTIFICATION_ON_FAILURE=true

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Email notifications (optional)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#staging-deployments

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Enable some development features for testing
DEBUG_MODE=true
DEVELOPMENT_FEATURES_ENABLED=true
TEST_DATA_ENABLED=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test data configuration
TEST_DATA_ENABLED=true
TEST_DATA_CLEANUP_AFTER_TESTS=true

# Mock external services for testing
MOCK_EXTERNAL_SERVICES=true
MOCK_EMAIL_SERVICE=true
MOCK_PAYMENT_SERVICE=true

